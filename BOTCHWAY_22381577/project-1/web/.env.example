# -----------------------------------------------------------------------------
# Copy this file to .env.local and adjust for your machine.
#   cp .env.example .env.local
#
# .env.local is git-ignored: real credentials must never be committed.
# -----------------------------------------------------------------------------

# Full connection string (takes precedence over the PG* variables below).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cpen208_ceds

# Or configure the parts individually and leave DATABASE_URL unset:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=cpen208_ceds
