# -----------------------------------------------------------------------------
# Copy to .env and adjust:  cp .env.example .env
# .env is git-ignored - real secrets must never be committed.
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Database built by ops/project-1/database/run_all.sh
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cpen208_ceds

# Or set the parts individually and leave DATABASE_URL unset:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=cpen208_ceds

# Signing key for JSON Web Tokens.
# REQUIRED when NODE_ENV=production - the service refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h

# Comma-separated allowed origins, or * for any (development only).
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
